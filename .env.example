# Пример файла переменных окружения
# Для работы скопируйте этот файл в `.env` и укажите реальные значения.
# Сам файл `.env` никогда не должен попадать в Git!

APP_ENV=development
LOG_LEVEL=INFO

# Секреты и токены (пример):
# API_KEY=your_secret_key_here
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
